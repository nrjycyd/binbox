{ 
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "::",
      "listen_port": 17443,
      "users": [
        {
          "password": "忽略"
        }
      ],
      "ignore_client_bandwidth": true,
      "tls": {
        "enabled": true,
        "alpn": [
          "h3"
        ],
        "certificate_path": "/root/hysteria/cert.crt",
        "key_path": "/root/hysteria/private.key"
      }
    }
  ],

  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
