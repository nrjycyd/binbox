{
  "inbounds": [
    // HTTP + SOCKS5 混合入站：本地代理端口，供手动指定代理的设备使用
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 8888
    },
    // 纯 SOCKS5 入站
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "::",
      "listen_port": 7891
    },
    // 透明代理 TCP 重定向入站：主路由将客户端 TCP 重定向到 :9887
    {
      "type": "redirect",
      "tag": "redirect-in",
      "listen": "::",
      "listen_port": 9887
    },
    // 透明代理 tproxy 入站：主路由将非国内 UDP/TCP tproxy 到 :9888
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 9888
    },
    // FakeIP DNS 入口：SmartDNS 将国外域名 DNS 转发到 :6666，经 hijack-dns 进 DNS 模块
    {
      "type": "direct",
      "tag": "fake-in",
      "listen": "::",
      "listen_port": 6666
    }
  ]
}